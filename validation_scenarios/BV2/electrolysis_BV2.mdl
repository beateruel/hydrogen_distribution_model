{UTF-8}
Avoided areation electricity=O2 from electrolysis used / Aeration efficiency
	~	kWh/H
	~		|

Integrated system electricity=Aeration electricity consumption + Electrolyser electricity consumption
	~	kWh/H
	~		|

Crematorium activity factor=Mortality seasonal index lookup(Hours of year) * (1 + Weekly mortality noise\
		)
	~	Dmnl
	~		|

Crematorium demand= Crematorium hourly consumption * Crematorium operating
	~	kg/H
	~	 MODIFY: was the constant 10.58 (and the S1 growth formula in the comment, \
		no longer needed).
	|

Crematorium hourly consumption=10.58
	~	kg/H
	~	 H2 consumption per operating hour (H2HT). This replaces the verification \
		scenarios constant "Crematorium demand = 10.58".
	|

Hour of day=MODULO ( Time , 24 )
	~	H
	~		|

Average cremations per day=9
	~	Cremation
	~	H2Hub Twente: typically 8-10 per day
	|

Hours of year=MODULO ( Time , 8736 )
	~	H
	~		|

Crematorium operating hours per day=Average cremations per day * Crematorium activity factor
	        * H2 per cremation / Crematorium hourly consumption
	~	H
	~	About 17 h on average (13.8-19 h over the year).
	|

H2 per cremation=20
	~	kg/Cremation
	~	H2Hub Twente Curren estimation
	|

Noise seed=1
	~	Dmnl
	~		|

Crematorium opening hour=5
	~	H
	~	Opening time at the day
	|

Mortality noise sd=0.0436
	~	Dmnl
	~		|

Mortality seasonal index lookup([(0,0.8)-(8736,1.2)],(0,1.1463), (168,1.1626), (336,1.1411\
		), (504,1.1561), (672,1.1589), (840,1.1394), (1008,1.146), (1176,1.1521), (1344,1.1341\
		), (1512,1.1426), (1680,1.0977), (1848,1.0656), (2016,1.0457), (2184,1.0116), (2352\
		,0.9855), (2520,0.9818), (2688,0.961), (2856,0.9504), (3024,0.9494), (3192,0.9405),\
		 (3360,0.9406), (3528,0.9289), (3696,0.9187), (3864,0.9238), (4032,0.917), (4200,0.9231\
		), (4368,0.9337), (4536,0.9149), (4704,0.9104), (4872,0.9181), (5040,0.8937), (5208\
		,0.901), (5376,0.9024), (5544,0.9033), (5712,0.9038), (5880,0.9016), (6048,0.9116),\
		 (6216,0.9181), (6384,0.9387), (6552,0.9554), (6720,0.9795), (6888,0.9684), (7056,0.9837\
		), (7224,0.9827), (7392,1.001), (7560,0.9961), (7728,1.0088), (7896,1.0233), (8064,\
		1.044), (8232,1.0617), (8400,1.0785), (8568,1.045), (8736,1.1463))
	~	Dmnl
	~	Data obtained from time series data of deaths (see Excel)
	|

Weekly mortality noise=SAMPLE IF TRUE(MODULO(Time, 168) = 0, RANDOM NORMAL(-3 * Mortality noise sd\
		, 3 * Mortality noise sd
	, 0, Mortality noise sd, Noise seed), 0)
	~	Dmnl
	~		|

Operating factor=Electrolizer H2 production BV/Electrolyzer capacity
	~	Dmnl
	~		|

Crematorium operating days per week=6
	~	Dmnl
	~	Assuming the crematorium opens 6 days per week
	|

Crematorium operating=IF THEN ELSE(
	        Day of week < Crematorium operating days per week :AND: Hour of day >= Crematorium opening hour\
		,
	        max(0, min(1, Crematorium opening hour + Crematorium operating hours per day\
		 - Hour of day)),
	        0)
	~	Dmnl
	~	 Fraction of each hour in operation (1 during full hours, between 0 and 1 \
		in the last hour).
	|

Day of week=MODULO(INTEGER(Time / 24), 7)
	~	Dmnl
	~	0 = Monday ... 6 = Sunday
	|

Electrolizer H2 production BV=1
	~	kg/H
	~		|

Electrolyzer capacity=1.105
	~	kg/H
	~		|

Electrolyzer capacity multiplier=8
	~	Dmnl
	~		|

Electrolyzer throughput=Electrolyzer capacity*Operating factor*Electrolyzer capacity multiplier
	~	kg/H
	~		|

recycled H2O in=Recycled water supply*water density*Recycled water allocation factor
	~	kg/H
	~		|

Recycled water allocation factor=1
	~	Dmnl
	~	For scenario 2.
		max(0, 1 - RAMP(1/336, 0, 336))
	|

Electricity attributed to H2 production=WWTP electricity allocated to electrolisys+Electrolyser electricity consumption
	~	kWh/H
	~		|

WWTP electricity allocated to electrolisys=Aeration electricity consumption*recycled H2O in\
		/(Treated water flow*water density)
	~	kWh/H
	~		|

Bakery demand=1
	~	kg/H
	~		|

actual H2O consumption=H2 produced in*"H2O/H2 mass yield ratio"
	~	kg/H
	~		|

Potable H2O share=IF THEN ELSE(
	    actual H2O consumption > 0,
	    potable H2O supplied / actual H2O consumption,
	    0
	)
	~	Dmnl
	~		|

Electrolyser electricity consumption=H2 produced in*Specific electrolyser electricity consumption
	~	kWh/H
	~		|

Potential H2O consumption=Potential H2 production*"H2O/H2 mass yield ratio"
	~	kg/H
	~		|

Internal H2 supplied=min(Total H2 demand, H2 Storage/delivery time)
	~	kg/H
	~		|

"Internal hydrogen supply contribution (%)"=100*Internal H2 supplied/Total H2 demand
	~	Dmnl
	~		|

External H2 supply=Outsourced H2 supplied
	~	kg/H
	~		|

"External hydrogen dependency (%)"=100*External H2 supply/Total H2 demand
	~	Dmnl
	~		|

Cumulative met demand H2= INTEG (Total H2 supplied,
		0)
	~	kg
	~		|

H2 service level=IF THEN ELSE(Cumulative met demand H2 + Cumulative unmet demand H2 >\
		 0,
	    Cumulative met demand H2 / (Cumulative met demand H2 + Cumulative unmet demand H2\
		), 1)
	~	Dmnl
	~		|

O2 produced=H2 produced in*"O2/H2 mass yield ratio"
	~	kg/H
	~		|

H2 demanded out=Internal H2 supplied
	~	kg/H
	~		|

Potential H2 production=min(
	    Electrolyzer throughput,
	    max(
	        0,
	        (Max H2 Storage Capacity-H2 Storage)/TIME STEP
	        + Internal H2 supplied
	    )
	)
	~	kg/H
	~		|

Cumulative outsourced H2= INTEG (Outsourced H2 delivery,
		0)
	~	kg
	~		|

Cumulative unmet demand H2= INTEG (Unmet H2 demand,
		0)
	~	kg
	~		|

delivery time=1
	~	H
	~		|

Residual H2 demand=max(0,Total H2 demand-Internal H2 supplied)
	~	kg/H
	~		|

Total H2 demand=Bakery demand+Crematorium demand
	~	kg/H
	~		|

Unmet H2 demand=max(0,Total H2 demand-Total H2 supplied)
	~	kg/H
	~		|

H2 produced in=min(
	    Potential H2 production,
	    available H2O for electrolysis/"H2O/H2 mass yield ratio"
	)
	~	kg/H
	~		|

H2 truck payload=400
	~	kg/truck
	~		|

H2 trucks per order=min(Maximum feasible H2 trucks,Required H2 trucks)
	~	truck
	~		|

H2 in transit out=Outsourced H2 delivery
	~	kg/H
	~		|

Required H2 trucks=INTEGER(Desired outsourced H2 order/H2 truck payload)
	+
	IF THEN ELSE(
	    Desired outsourced H2 order/H2 truck payload
	    > INTEGER(Desired outsourced H2 order/H2 truck payload),
	    1,
	    0
	)
	~	truck
	~		|

Maximum feasible H2 trucks=INTEGER(max(0, Maximum outsourced storage capacity-Outsourced H2 inventory position\
		)/H2 truck payload)
	~	truck
	~		|

Maximum outsourced storage capacity=1200
	~	kg
	~		|

H2 averaging time=24
	~	H
	~		|

Outsourced H2 storage= INTEG (Outsourced H2 delivery-Outsourced H2 supplied,
		800)
	~	kg
	~		|

H2 in transit= INTEG (H2 in transit in-H2 in transit out,
		0)
	~	kg
	~		|

H2 in transit in=Outsourced H2 ordered
	~	kg/H
	~		|

Effective outsourced H2 order up to level=min(Desired outsourced H2 order up to level\
		,Maximum outsourced storage capacity)
	~	kg
	~		|

H2 order quantity=H2 truck payload*H2 trucks per order
	~	kg
	~		|

Outsourced H2 delivery=DELAY FIXED (Outsourced H2 ordered , H2 supplier lead time , 0\
		 )
	~	kg/H
	~		|

outsourced H2 delivery time=1
	~	H
	~		|

Desired outsourced H2 order=max(0,Effective outsourced H2 order up to level-Outsourced H2 inventory position\
		)
	~	kg
	~		|

Desired outsourced H2 order up to level=Expected H2 outsourced demand*(H2 review period\
		+H2 safety coverage time+H2 supplier lead time)
	~	kg
	~		|

Outsourced H2 supplied=min(Residual H2 demand,Outsourced H2 storage/outsourced H2 delivery time\
		)
	~	kg/H
	~		|

H2 supplier lead time=12
	~	H
	~		|

Expected H2 outsourced demand=SMOOTH (  Residual H2 demand, H2 averaging time )
	~	kg/H
	~		|

First H2 order time=0
	~	H
	~		|

Total H2 supplied=Outsourced H2 supplied+Internal H2 supplied
	~	kg/H
	~		|

H2 order review=PULSE TRAIN ( First H2 order time , TIME STEP , H2 review period , FINAL TIME\
		 )
	~	Dmnl
	~		|

Outsourced H2 ordered=H2 order review*H2 order quantity/TIME STEP
	~	kg/H
	~		|

H2 review period=24
	~	H
	~		|

H2 safety coverage time=24
	~	H
	~		|

Outsourced H2 inventory position=H2 in transit+Outsourced H2 storage
	~	kg
	~		|

Specific electrolyser electricity consumption=50
	~	kWh/kg
	~		|

COD load treated=COD concentration*treated wastewater/1000
	~	kg/H
	~		|

Aeration efficiency=1.67
	~	kg/kWh
	~		|

Aeration electricity consumption=O2 supplied from air/Aeration efficiency
	~	kWh/H
	~		|

available H2O for electrolysis=recycled H2O in+potable H2O supplied
	~	kg/H
	~		|

treated wastewater=Biological treatment
	~	m3/H
	~		|

Baseline aeration electricity=WWTP O2 demand/Aeration efficiency
	~	kWh/H
	~		|

clean water delivery time=1
	~	H
	~		|

Reclaimed Water storage= INTEG (Reclaimed water production-Recycled water supply,
		100)
	~	m3
	~		|

Reclaimed water production=min(Treated water flow, Potential H2O consumption/water density\
		)
	~	m3/H
	~		|

Recycled water supply=min(
	    Potential H2O consumption/water density,
	   Reclaimed Water storage / clean water delivery time
	)
	~	m3/H
	~		|

COD concentration=500
	~	mg/l
	~		|

wastewater in=Wastewater inflow
	~	m3/H
	~		|

Treated water flow=Biological treatment
	~	m3/H
	~		|

Dirty water storage= INTEG (wastewater in-treated wastewater,
		400)
	~	m3
	~		|

Biological treatment=Dirty water storage/wastewater treatment time
	~	m3/H
	~		|

Wastewater inflow=400
	~	m3/H
	~		|

WWTP O2 demand=COD load treated*Specific O2 requirement
	~	kg/H
	~		|

O2 supplied from air=max(0, WWTP O2 demand - O2 from electrolysis used)
	~	kg/H
	~		|

Specific O2 requirement=1
	~	kg/kg
	~		|

O2 from electrolysis used=min(O2 produced,WWTP O2 demand)
	~	kg/H
	~		|

Potable H2O demand=max(
	    0,
	    Potential H2O consumption - recycled H2O in
	)
	~	kg/H
	~		|

potable H2O supplied=Potable H2O demand
	~	kg/H
	~		|

Unused O2=max(0, O2 produced - O2 from electrolysis used)
	~	kg/H
	~		|

wastewater treatment time=1
	~	H
	~		|

water density=1000
	~	kg/m3
	~		|

Average production scenario 1=10.9395/24
	~	kg/H
	~		|

H2 Storage= INTEG (H2 produced in-H2 demanded out,
		500)
	~	kg
	~		|

Max H2 Storage Capacity=500
	~	kg
	~		|

"O2/H2 mass yield ratio"=8
	~	kg/kg
	~		|

"H2O/H2 mass yield ratio"=9
	~	kg/kg
	~		|

